# mailwart — copy to .env.local (never commit secrets)
# Deployment URLs below are examples — replace with your hosts.
# Dokploy: set the same keys in the compose env UI (no .env file in the image).

# ==============================================================================
# --- PostgreSQL Database (Console Users, System Settings, OTP Tokens) ---
# ==============================================================================
# Docker/Dokploy network: postgresql://<user>:<password>@mailwart-postgres:5432/<db>
# Local dev: postgresql://postgres:postgres@localhost:5432/mailwart
DATABASE_URL=postgresql://mailwart:changeme@mailwart-postgres:5432/mailwart

# ==============================================================================
# --- Primary Admin Account & Reseeding Protection ---
# ==============================================================================
# Primary administrator console username (default: yehia)
APP_ADMIN_USER=yehia
# Initial seed password for the primary administrator account
APP_ADMIN_PASSWORD=
# iron-session cookie seal — required, ≥32 random characters (generate: openssl rand -base64 32)
SESSION_SECRET=

# --- Reseed Protection ---
# Set to 'true' ONLY when you explicitly want to override/force-reseed the primary
# administrator password in PostgreSQL back to APP_ADMIN_PASSWORD upon container boot.
# Keep 'false' (or unset) during normal deployment so user/admin password changes
# persisted in the database are NEVER overwritten on restarts or redeployments.
# (CRITICAL: Do not set to 'true' in live production compose environments).
FORCE_RESEED_ADMIN_PASSWORD=false

# ==============================================================================
# --- Stalwart JMAP & Management API (v0.16+) ---
# ==============================================================================
# Local Windows: public HTTPS or SSH tunnel.
# VPS/Docker: http://stalwart-mail:8080/jmap (shared stalwart-net)
STALWART_JMAP_URL=https://mail.example.com/jmap
STALWART_ADMIN_USER=admin@example.com
STALWART_ADMIN_PASSWORD=
STALWART_ADMIN_UI_URL=https://mail.example.com/admin

# ==============================================================================
# --- Roundcube Webmail + SSO ---
# ==============================================================================
# Public webmail base URL (trailing slash preferred)
ROUNDCUBE_URL=https://mail.example.com/webmail/
# Shared HMAC secret for signed mailbox SSO (≥32 chars). Generate: openssl rand -base64 32
WEBMAIL_SSO_SECRET=
# Roundcube session encryption key (compose ROUNDCUBEMAIL_DES_KEY, ≥24 chars)
ROUNDCUBE_DES_KEY=
# Dedicated Stalwart account with `impersonate` privilege; falls back to STALWART_ADMIN_* when unset.
WEBMAIL_IMPERSONATOR_USER=
WEBMAIL_IMPERSONATOR_PASSWORD=

# ==============================================================================
# --- Cloudflare DNS Automation (Optional) ---
# ==============================================================================
# Cloudflare API Token with Zone:DNS:Edit permissions across managed domains
# CLOUDFLARE_API_TOKEN=
# Optional default Zone ID
# CLOUDFLARE_ZONE_ID=

# ==============================================================================
# --- Audit Log ---
# ==============================================================================
# Append-only JSONL audit trail. Docker default: /data/audit.jsonl on volume mailwart_audit
# AUDIT_LOG_PATH=/data/audit.jsonl

# ==============================================================================
# --- mailwart Copilot (AI Assistance) — server-only; never NEXT_PUBLIC_* ---
# ==============================================================================
# Active provider + model (optional; Settings UI can also set preference)
# COPILOT_PROVIDER=openai
# COPILOT_MODEL=gpt-4o
# Generic key/base for the active provider (optional fallback)
# COPILOT_API_KEY=
# COPILOT_BASE_URL=
# Provider-specific API keys
# COPILOT_OPENAI_API_KEY=
# COPILOT_ANTHROPIC_API_KEY=
# COPILOT_GOOGLE_API_KEY=
# COPILOT_CEREBRAS_API_KEY=
# COPILOT_GROQ_API_KEY=
# COPILOT_MISTRAL_API_KEY=
# COPILOT_DEEPSEEK_API_KEY=
# COPILOT_MOONSHOT_API_KEY=
# COPILOT_OPENROUTER_API_KEY=
# Ollama base URL if using local model (e.g. http://127.0.0.1:11434)
# COPILOT_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Docker/Dokploy path for server-side preferences JSON (default: /data/copilot-settings.json)
# COPILOT_SETTINGS_PATH=/data/copilot-settings.json
# Authenticated conversation records path (default: /data/copilot-history)
# COPILOT_HISTORY_PATH=/data/copilot-history
