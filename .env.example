# Email Manager — copy to .env.local (never commit secrets)

# Stalwart JMAP (v0.16+). Local Windows: use public HTTPS or SSH tunnel.
# On VPS/Docker: http://stalwart-mail:8080/jmap or http://127.0.0.1:8080/jmap
STALWART_JMAP_URL=https://mail.yehia.dev/jmap
STALWART_ADMIN_USER=admin@zokm.me
STALWART_ADMIN_PASSWORD=

# Integrated Roundcube (same-host path)
ROUNDCUBE_URL=https://email.yehia.dev/webmail/
WEBMAIL_SSO_SECRET=
ROUNDCUBE_DES_KEY=
# Optional dedicated Stalwart account with `impersonate`; compose falls back to
# STALWART_ADMIN_* when these are unset.
WEBMAIL_IMPERSONATOR_USER=
WEBMAIL_IMPERSONATOR_PASSWORD=
STALWART_ADMIN_UI_URL=https://mail.yehia.dev/admin

# Dashboard login (separate from Stalwart admin) — required for /login
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=

# iron-session cookie seal — required, ≥32 random characters
# Generate: openssl rand -base64 32
SESSION_SECRET=
