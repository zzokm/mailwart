# mailwart — copy to .env.local (never commit secrets)
# Deployment URLs below are examples — replace with your hosts.
# Dokploy: set the same keys in the compose env UI (no .env file in the image).

# --- Stalwart JMAP (v0.16+) ---
# Local Windows: public HTTPS or SSH tunnel.
# VPS/Docker: http://stalwart-mail:8080/jmap (shared stalwart-net)
STALWART_JMAP_URL=https://mail.example.com/jmap
STALWART_ADMIN_USER=admin@example.com
STALWART_ADMIN_PASSWORD=
STALWART_ADMIN_UI_URL=https://mail.example.com/admin

# --- Roundcube + SSO ---
# Public webmail base (trailing slash preferred)
ROUNDCUBE_URL=https://mail.example.com/webmail/
# Shared HMAC secret for signed mailbox SSO (≥32 chars). Generate: openssl rand -base64 32
WEBMAIL_SSO_SECRET=
# Roundcube session encryption key (compose ROUNDCUBEMAIL_DES_KEY)
ROUNDCUBE_DES_KEY=
# Optional dedicated Stalwart account with `impersonate`; compose falls back to
# STALWART_ADMIN_* when these are unset.
WEBMAIL_IMPERSONATOR_USER=
WEBMAIL_IMPERSONATOR_PASSWORD=

# --- Dashboard auth (separate from Stalwart admin) ---
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=
# iron-session cookie seal — required, ≥32 random characters
# Generate: openssl rand -base64 32
SESSION_SECRET=

# --- Optional DNS health expectations (Architecture §10) ---
# DNS_EXPECTED_MX=mail.example.com
# DNS_DKIM_SELECTORS=stalwart,default
# DNS_EXPECTED_SPF=include:_spf.example.com

# --- Audit log (Architecture §9.2) ---
# Append-only JSONL. Docker default: /data/audit.jsonl on volume mailwart_audit
# AUDIT_LOG_PATH=/data/audit.jsonl
