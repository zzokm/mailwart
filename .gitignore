# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.pem
*.key
*.p12
*.pfx
*.crt
*.csr
id_rsa*
id_ed25519*
*.secret
*.secrets
*credentials*.txt
*password*.txt
email-manager-admin.txt

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets; keep the example template
.env
.env.*
!.env.example

# local certs / keys that might be dropped in-tree
/certs/
/keys/
/secrets/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local audit JSONL (Architecture §9.2)
/data/

# IDE / OS
.idea/
.vscode/
*.swp
*~